@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom pb-0 pt-4 px-4">
                    <h4 class="text-primary fw-bold mb-1">Hesap Yönetimi</h4>
                    <p class="text-muted small">Kullanıcı profilinizi, güvenlik ayarlarınızı ve tercihlerinizi bu alandan yapılandırabilirsiniz.</p>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-3 border-end pe-md-3">
                            <partial name="_ManageNav" />
                        </div>
                        <div class="col-md-9 ps-md-4 pt-3 pt-md-0">
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
