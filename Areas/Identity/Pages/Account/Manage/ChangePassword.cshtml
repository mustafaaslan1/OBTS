@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Şifre Değiştirme";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h5 class="mb-4 text-secondary fw-semibold">@ViewData["Title"]</h5>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8 col-lg-7">

        <div class="alert alert-info border-0 shadow-sm rounded-3 small mb-4">
            <strong>Bilgi:</strong> Hesabınızın güvenliği için yeni şifrenizin en az 6 karakter uzunluğunda olmasına dikkat ediniz.
        </div>

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3 shadow-sm">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Mevcut Şifre" />
                <label asp-for="Input.OldPassword" class="form-label">Mevcut Şifre</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3 shadow-sm">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Yeni Şifre" />
                <label asp-for="Input.NewPassword" class="form-label">Yeni Şifre</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4 shadow-sm">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Yeni Şifre (Tekrar)" />
                <label asp-for="Input.ConfirmPassword" class="form-label">Yeni Şifre (Tekrar)</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary shadow-sm fw-semibold">
                Şifreyi Güncelle
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}