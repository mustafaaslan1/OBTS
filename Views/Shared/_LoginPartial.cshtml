@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white fw-bold d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle fs-4 me-2 text-white"></i>
                Hesabım
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="profileDropdown">
                <li>
                    <div class="px-3 py-2 text-muted small border-bottom mb-2">
                        Oturum açıldı:<br />
                        <strong class="text-dark">@User.Identity?.Name</strong>
                    </div>
                </li>

                <li>
                    @if (User.IsInRole("Yonetici"))
                    {
                        <a class="dropdown-item d-flex align-items-center py-2 fw-medium" asp-controller="Arizalar" asp-action="YoneticiDashboard">
                            <i class="bi bi-speedometer2 me-2 fs-5 text-secondary"></i> Yönetim Paneli
                        </a>
                    }
                    else if (User.IsInRole("Tekniker"))
                    {
                        <a class="dropdown-item d-flex align-items-center py-2 fw-medium" asp-controller="Arizalar" asp-action="TeknikerDashboard">
                            <i class="bi bi-tools me-2 fs-5 text-secondary"></i> Tekniker Paneli
                        </a>
                    }
                    else
                    {
                        <a class="dropdown-item d-flex align-items-center py-2 fw-medium" asp-controller="Arizalar" asp-action="PersonelDashboard">
                            <i class="bi bi-plus-circle-fill me-2 fs-5 text-secondary"></i> Personel Paneli
                        </a>
                    }
                </li>

                <li>
                    <a class="dropdown-item d-flex align-items-center py-2 fw-medium" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-sliders me-2 text-secondary"></i> Profil ve Güvenlik Ayarları
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="form-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item d-flex align-items-center text-danger py-2 fw-bold w-100 text-start">
                            <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
</ul>