@model IEnumerable<OBTS_Web.Models.KullaniciListeViewModel>
@{
    ViewData["Title"] = "Tüm Personeller";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Sistem Kullanıcıları</h3>
        <a href="@Url.Action("YoneticiDashboard", "Arizalar")" class="btn btn-outline-secondary rounded-pill shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Dashboard'a Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted">
                        <tr>
                            <th class="ps-4">Personel Bilgisi</th>
                            <th>Dahili Hat</th>
                            <th>Sistem Rolü</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.AdSoyad</div>
                                    <div class="text-muted small">@item.Email</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary rounded-pill px-3"><i class="bi bi-telephone-fill me-1"></i> @item.DahiliHat</span>
                                </td>
                                <td>
                                    @if (item.Rol == "Yonetici")
                                    {
                                        <span class="badge bg-danger">Yönetici</span>
                                    }
                                    else if (item.Rol == "Tekniker")
                                    {

                                        <span class="badge bg-warning text-dark">Tekniker</span>
                                    }
                                    else
                                    {

                                        <span class="badge bg-info text-dark">Personel</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsApproved)
                                    {
                                        <span class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i>Onaylı</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-medium"><i class="bi bi-clock-fill me-1"></i>Onay Bekliyor</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Detay", "KullaniciYonetimi", new { id = item.UserId })" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-gear-fill me-1"></i> Yönet
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>