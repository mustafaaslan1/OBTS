@model OBTS_Web.Models.YoneticiDashboardViewModel
@{
    ViewData["Title"] = "Yönetici Kontrol Paneli";
}

<style>
    body {
        background-color: #f4f7f6;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #0d47a1 0%, #1976d2 100%);
        color: white;
        border-radius: 1rem;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 20px rgba(13, 71, 161, 0.15);
    }

    .stat-card {
        border-radius: 1rem;
        border: none;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .table-card {
        border-radius: 1rem;
        border: none;
        overflow: hidden;
    }

        .table-card .card-header {
            background-color: #ffffff;
            border-bottom: 2px solid #f0f2f5;
            padding: 1.25rem 1.5rem;
        }

    .table-custom th {
        font-weight: 600;
        color: #6c757d;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }
</style>

<div class="container-fluid mt-4 mb-5">

    <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>DHMİ Yönetici Paneli</h2>
            <p class="mb-0 opacity-75">Sistem İstatistikleri ve Operasyonel Takip Merkezi</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Index", "KullaniciYonetimi")" class="btn btn-outline-light btn-lg fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-people-fill me-2"></i>Tüm Kullanıcılar
            </a>
            <a href="@Url.Action("TeknikerDashboard", "Arizalar")" class="btn btn-light btn-lg text-primary fw-bold rounded-pill px-4 shadow">
                <i class="bi bi-tools me-2"></i>Tüm Arızalara Müdahale Et
            </a>
        </div>
    </div>

    @if (TempData["BasariMesaji"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["BasariMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.85rem;">Toplam Arıza</div>
                        <div class="h2 mb-0 fw-bolder text-dark">@Model.ToplamArizaSayisi</div>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.85rem;">Acil Öncelikli</div>
                        <div class="h2 mb-0 fw-bolder text-danger">@Model.AcilOncelikliArizaSayisi</div>
                    </div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.85rem;">Firmada Bekleyen</div>
                        <div class="h2 mb-0 fw-bolder text-warning">@Model.FirmadaBekleyenArizaSayisi</div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.85rem;">Çözülen İşlemler</div>
                        <div class="h2 mb-0 fw-bolder text-success">@Model.CozulenArizaSayisi</div>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-6 mb-4">
            <div class="card table-card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-dark">
                        <i class="bi bi-person-plus-fill text-primary me-2"></i>Onay Bekleyen Kullanıcılar
                    </h5>
                    <span class="badge bg-danger rounded-pill fs-6 px-3">@Model.OnayBekleyenKullaniciSayisi Kişi</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">E-Posta Adresi</th>
                                    <th class="text-end pe-4">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OnayBekleyenKullanicilar.Any())
                                {
                                    foreach (var item in Model.OnayBekleyenKullanicilar)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-medium text-dark">@item.Email</td>
                                            <td class="text-end pe-4">
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#kullaniciOnayModal"
                                                        data-userid="@item.UserId"
                                                        data-email="@item.Email">
                                                    <i class="bi bi-check2-circle me-1"></i> İncele ve Onayla
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-5">
                                            <i class="bi bi-check2-all fs-1 text-success opacity-50 d-block mb-2"></i>
                                            Tüm kullanıcı hesapları güncel ve onaylı.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card table-card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="m-0 fw-bold text-dark">
                        <i class="bi bi-activity text-success me-2"></i>Tekniker Performans İzleme
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom text-center align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="text-start ps-4">Tekniker (E-Posta)</th>
                                    <th>Müdahale Edilen</th>
                                    <th>Çözüme Kavuşan</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TeknikerPerformanslari.Any())
                                {
                                    foreach (var perf in Model.TeknikerPerformanslari.OrderByDescending(p => p.CozulenIslem))
                                    {
                                        <tr>
                                            <td class="text-start ps-4 fw-medium text-dark">
                                                <i class="bi bi-person-circle text-secondary me-2"></i>@perf.TeknikerAdSoyad
                                            </td>
                                            <td><span class="badge bg-secondary rounded-pill px-3 fs-6">@perf.ToplamMudahale</span></td>
                                            <td><span class="badge bg-success rounded-pill px-3 fs-6">@perf.CozulenIslem</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted py-5">
                                            <i class="bi bi-inbox fs-1 text-secondary opacity-50 d-block mb-2"></i>
                                            Sistemde henüz bir tekniker işlemi bulunmuyor.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kullaniciOnayModal" tabindex="-1" aria-labelledby="kullaniciOnayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="kullaniciOnayModalLabel"><i class="bi bi-person-check-fill me-2"></i>Kullanıcı Onayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Arizalar" asp-action="KullaniciOnayla" method="post">
                <div class="modal-body p-4">
                    <p class="text-muted mb-4">Aşağıdaki kullanıcının sisteme giriş yapabilmesi için yetki seviyesini belirleyip onaylayınız.</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">E-Posta Adresi</label>
                        <div class="form-control bg-light" id="displayUserEmail"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sistem Rolü (Yetki)</label>
                        <select name="atanacakRol" class="form-select" required>
                            <option value="" disabled selected>Lütfen bir rol seçiniz...</option>
                            <option value="Personel">Personel (Sadece Arıza Bildirebilir)</option>
                            <option value="Tekniker">Tekniker (Arızalara Müdahale Edebilir)</option>
                        </select>
                    </div>

                    <input type="hidden" name="onayUserId" id="hiddenUserId" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Hesabı Onayla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var onayModal = document.getElementById('kullaniciOnayModal');
        onayModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var userId = button.getAttribute('data-userid');
            var userEmail = button.getAttribute('data-email');

            var hiddenUserIdInput = onayModal.querySelector('#hiddenUserId');
            var displayEmailDiv = onayModal.querySelector('#displayUserEmail');

            hiddenUserIdInput.value = userId;
            displayEmailDiv.textContent = userEmail;
        });
    </script>
}